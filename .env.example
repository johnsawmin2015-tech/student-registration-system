# Runtime mode. Production defaults to postgres and refuses demo unless explicitly allowed.
DATA_MODE=demo
ALLOW_DEMO_IN_PRODUCTION=false

# Required for DATA_MODE=postgres. The Compose defaults are local-only examples.
DATABASE_URL=postgresql://northstar_demo:northstar_demo_local_only@127.0.0.1:5432/northstar_registration_demo
DATABASE_POOL_SIZE=10

# Required outside local demo mode. Generate at least 32 random characters; never commit it.
SESSION_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
# Optional local HTTPS testing flag. Production always forces Secure cookies.
SESSION_COOKIE_SECURE=false

# Enable only behind a verified HTTPS deployment. Trust proxy headers only behind a trusted proxy.
ENABLE_HSTS=false
TRUST_PROXY=false

# Optional local, server-only demo adapter credential. Never reuse a real password.
DEMO_PASSWORD=DemoOnly!2026

# Docker Compose local database settings.
POSTGRES_DB=northstar_registration_demo
POSTGRES_USER=northstar_demo
POSTGRES_PASSWORD=northstar_demo_local_only
POSTGRES_PORT=5432

# PostgreSQL synthetic fixture credentials (minimum 14 characters).
SEED_ADMIN_PASSWORD=replace-with-a-local-demo-password
SEED_STAFF_PASSWORD=replace-with-a-local-demo-password
SEED_VIEWER_PASSWORD=replace-with-a-local-demo-password

# Destructive fixture reset remains off unless this exact explicit confirmation is supplied.
# SEED_RESET_CONFIRM=RESET_NORTHSTAR_DEMO_FIXTURES
# SEED_ALLOW_REMOTE_DEMO_DATABASE=NORTHSTAR_DEMO_ONLY
